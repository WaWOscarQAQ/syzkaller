# requires: -threaded
# Grow a non-degraded RAID5 array from three ramdisks to four ramdisks.
# Start the reshape with the legacy ioctl and sysfs interfaces and do I/O on it.

r0 = openat$md_new_array(AUTO, &AUTO='/sys/module/md_mod/parameters/new_array\x00', AUTO, AUTO)
write$md_new_array(r0, &AUTO={'md', @num=0x0}, AUTO)
r1 = openat$md(AUTO, &AUTO={'/dev/md', @num=0x0, AUTO}, 0x2, AUTO)
ioctl$SET_ARRAY_INFO(r1, AUTO, &AUTO={0x0, 0x5a, AUTO, 0x0, 0x5, 0x800, AUTO, 0x3, AUTO, 0x0, AUTO, 0x1, AUTO, AUTO, AUTO, AUTO, 0x2, 0x10000})
ioctl$ADD_NEW_DISK(r1, AUTO, &AUTO={0x0, {AUTO, 0x0}, 0x0, 0x6})
ioctl$ADD_NEW_DISK(r1, AUTO, &AUTO={0x1, {AUTO, 0x1}, 0x1, 0x6})
ioctl$ADD_NEW_DISK(r1, AUTO, &AUTO={0x2, {AUTO, 0x2}, 0x2, 0x6})
ioctl$ADD_NEW_DISK(r1, AUTO, &AUTO={0x3, {AUTO, 0x3}, 0xffffffff, 0x0})
ioctl$RUN_ARRAY(r1, AUTO, &AUTO={AUTO, AUTO, AUTO})
r2 = openat$md_sysfs(AUTO, &AUTO={'/sys/block/md', @num=0x0, '/md/', @array='raid_disks\x00'}, 0x1, AUTO)
write$md_sysfs(r2, &AUTO=@str='4', AUTO)
r3 = openat$md_sysfs(AUTO, &AUTO={'/sys/block/md', @num=0x0, '/md/', @array='sync_action\x00'}, 0x1, AUTO)
write$md_sysfs(r3, &AUTO=@str='reshape', AUTO)
pwrite64(r1, &AUTO="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", AUTO, 0x1000)
pread64(r1, &AUTO=""/512, AUTO, 0x10000)
ioctl$STOP_ARRAY(r1, AUTO, AUTO)
